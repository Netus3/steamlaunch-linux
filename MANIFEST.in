include LICENSE THIRD_PARTY_NOTICES.md README.md README.ru.md CHANGELOG.md CONTRIBUTING.md run.sh
recursive-include steamlaunch *.py *.svg
recursive-include tests *.py
recursive-include scripts *.py *.sh
recursive-include packaging *.py *.spec *.txt *.sh *.desktop
recursive-include docs *.md
recursive-include .github *.yml *.md
exclude PROGRESS.md
global-exclude *.py[cod] __pycache__
